# Copy to .env. Everything is optional; the app runs with no key using rule-based extraction.

# "auto" = use Claude when ANTHROPIC_API_KEY is set, otherwise rules. Also: "llm", "heuristic".
EXTRACTOR=auto
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Default is SQLite at contracts/contracts.db. For Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/contracts

EXPIRING_SOON_DAYS=60
WATCH_INBOX=true
